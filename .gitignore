data/
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
*.log
*.bak
*.orig
nohup.out

# --- python ---------------------------------------------------------------
__pycache__/
*.pyc
*.pyo
.venv/
venv/

